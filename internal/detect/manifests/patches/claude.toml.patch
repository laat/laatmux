--- a/claude.toml
+++ b/claude.toml
@@ -17,14 +17,42 @@
 id = "live_turn_working"
 state = "working"
 priority = 970
-region = "bottom_non_empty_lines(12)"
+# 24, not 12: the agents panel under the footer ("← for agents" opened)
+# lists the subagents, a line each plus "↓ N more", and with it and a
+# tip under the spinner line the spinner sits 13 or more non-empty lines
+# from the bottom (laatmux, 2026-10-08).
+region = "bottom_non_empty_lines(24)"
 visible_working = true
 any = [
   { line_regex = ['^\s*[⏸⏵].*esc to interrupt(?:\s|·|$)'] },
-  { line_regex = ['^\s*[\x{002A}\x{00B7}\x{2722}\x{2733}\x{2736}\x{273B}\x{273D}]\s+\S.*…(?:\s+\(\d+[smh](?:\s|·)|\s*$)'] },
+  # The timer may come after a note in the parentheses, '(running PostToolUse hook · 29s · ↓ 1.4k tokens)'
+  # with a user's hook (laatmux, 2026-10-08).
+  { line_regex = ['^\s*[\x{002A}\x{00B7}\x{2722}\x{2733}\x{2736}\x{273B}\x{273D}]\s+\S.*…(?:\s+\((?:[^()]*?·\s+)?\d+[smh](?:\s|·)|\s*$)'] },
+  # 2.1.29x waiting on the API, '✳ Waiting for API response · will retry in Ns' say: no ellipsis,
+  # and the footer may lack 'esc to interrupt' meanwhile (laatmux, 2026-10-08).
+  { line_regex = ['^\s*[\x{002A}\x{00B7}\x{2722}\x{2733}\x{2736}\x{273B}\x{273D}]\s+Waiting for API response\b'] },
 ]
 
 [[rules]]
+# The agents panel (2.1.29x, "← for agents" opened) under the footer:
+# a line per teammate, "◯ name  what it does  42m 27s · ↓" while it
+# runs; main's own turn is over, its prompt empty, but the session works
+# until they finish (laatmux, 2026-10-08).
+id = "teammates_working"
+state = "working"
+priority = 966
+region = "bottom_non_empty_lines(24)"
+visible_working = true
+# The panel's cursor row reads "❯ ◯ name …"; a permission dialog over
+# the panel is the user's to answer first.
+line_regex = ['^\s*(?:\x{276F}\s*)?\x{25EF}\s+\S+\s+\S.*\s\d+[smh](?:\s\d+s)?\s+·']
+not = [
+  { contains = ["Do you want to proceed?"] },
+  { regex = ['(?i)esc to cancel'] },
+  { contains = ["waiting for permission"] },
+]
+
+[[rules]]
 id = "background_agents_working"
 state = "working"
 priority = 965
